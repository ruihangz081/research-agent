\newcommand{\BrokerNeedSpace}[1]{%
  \begingroup\setlength{\dimen@}{#1}%
  \vskip\z@\@plus\dimen@\penalty-100%
  \vskip\z@\@plus-\dimen@\vskip\dimen@\penalty9999%
  \vskip-\dimen@\vskip\z@skip\endgroup}
\makeatother
