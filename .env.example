# ═══════════════════════════════════════════════════
# LLM 配置（OpenAI 兼容 Chat Completions API）
# ═══════════════════════════════════════════════════

# --- OpenAI ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxxxx
LLM_MODEL=gpt-4o

# --- DeepSeek ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxx
# LLM_MODEL=deepseek-chat

# --- 通义千问（Qwen，阿里云 DashScope） ---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxxxxx
# LLM_MODEL=qwen-max

# --- 本地 Ollama ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:72b

# --- 本地 vLLM ---
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=token-placeholder
# LLM_MODEL=your-model-name

# ═══════════════════════════════════════════════════
# Web Search 配置（可选，默认 AnySearch；Key 可选，失败时降级到 DuckDuckGo）
# ═══════════════════════════════════════════════════
SEARCH_API_PROVIDER=anysearch
# SEARCH_API_KEY=

# ═══════════════════════════════════════════════════
# Agent 配置
# ═══════════════════════════════════════════════════
# Agent1 多轮对话上限（默认 5）
STRATEGIST_MAX_ROUNDS=5
# Agent2↔3 采集-验证循环上限（默认 3）
MAX_COLLECT_ROUNDS=3

# ═══════════════════════════════════════════════════
# 券商研报排版
# ═══════════════════════════════════════════════════
REPORT_FORMATTING_SKILL=brokerage-report-formatting
REPORT_THEME=brokerage_research_v1
REPORT_MAX_CHARTS=20
REPORT_ENABLE_LLM_CHART_FALLBACK=true
REPORT_PANDOC_BIN=pandoc
REPORT_LATEX_ENGINE=xelatex
REPORT_RENDER_TIMEOUT=120

# ═══════════════════════════════════════════════════
# 原文读取、真实语义检索与项目 ACL（可选）
# ═══════════════════════════════════════════════════
SOURCE_DATA_DIR=.data/sources
# SOURCE_EMBEDDING_BASE_URL=https://api.openai.com/v1
# SOURCE_EMBEDDING_API_KEY=sk-xxxxxx
# SOURCE_EMBEDDING_MODEL=text-embedding-3-small
# SOURCE_API_KEYS_JSON={"local-admin":"*"}
